# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Postgres password (any long random string).
PG_PASSWORD=change-me-to-a-long-random-string

# Optional: Telegram bot token from @BotFather. Without it the hub runs API-only.
# In BotFather: /setprivacy -> Disable, so the bot sees all group messages.
DAVRA_TELEGRAM_TOKEN=

# Optional: Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels).
# Route your public hostname to http://hub:8080.
CF_TUNNEL_TOKEN=

# Local port for the hub (bound to 127.0.0.1 only).
DAVRA_PORT=8787

# Recommended: seals GitHub webhook secrets in the database. Generate with
#   openssl rand -hex 32
# and keep a copy outside the server's backups (a password manager). Without
# it the hub cannot read sealed secrets; re-run `project github` to make new ones.
DAVRA_MASTER_KEY=

# Optional: time zone Postgres shows times in (stored times are UTC-safe
# timestamptz either way). For an existing database also run:
#   alter database davra set timezone to 'Asia/Tashkent';
DAVRA_TZ=UTC

# Optional: language of the bot's Telegram card labels: en (default) or uz.
DAVRA_LANG=en

# Optional: daily digest. With an Anthropic API key the hub writes a short
# summary of each project's day (Claude Haiku) after DAVRA_DIGEST_HOUR, local
# time of the database (see DAVRA_TZ), into the room and its Telegram group.
DAVRA_ANTHROPIC_API_KEY=
DAVRA_DIGEST_HOUR=19
