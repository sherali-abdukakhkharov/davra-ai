# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Postgres password (any long random string).
PG_PASSWORD=change-me-to-a-long-random-string

# Optional: Telegram bot token from @BotFather. Without it the hub runs API-only.
# In BotFather: /setprivacy -> Disable, so the bot sees all group messages.
DAVRA_TELEGRAM_TOKEN=

# Optional: Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels).
# Route your public hostname to http://hub:8080.
CF_TUNNEL_TOKEN=

# Local port for the hub (bound to 127.0.0.1 only).
DAVRA_PORT=8787
